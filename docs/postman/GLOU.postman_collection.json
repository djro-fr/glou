        {
          "name": "/fountains",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test(\"renvoie les 481 fontaines\", () => {",
                  "  pm.expect(data).to.be.an(\"array\").with.lengthOf(481);",
                  "});",
                  "pm.test(\"chaque fontaine a les champs attendus\", () => {",
                  "  pm.expect(data[0]).to.include.all.keys(\"id\", \"location_f\", \"type_f\", \"address_f\", \"city\", \"status_f\", \"latitude\", \"longitude\", \"district_number\", \"name_d\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fountains",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fountains"
              ]
            }
          },
          "response": []
        },
