      "$value": {
        "fontFamily": "{family-text}",
        "fontWeight": "300",
        "fontSize": "{ft-siz-medium}",
        "lineHeight": "1.4"
      },
      "$type": "typography"
    },
    "caption": {
      "$value": {
        "fontFamily": "{family-text}",
        "fontWeight": "400",
        "fontSize": "{ft-siz-x-small}",
        "lineHeight": "1.4"
      },
      "$type": "typography"
    },
    "a": {
      "$value": {
        "fontFamily": "{family-text}",
        "textDecoration": "underline",
        "fontWeight": "500"
      },
      "$type": "typography"
    }
