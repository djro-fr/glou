    "shd-btn": {
      "$value": {
        "x": "0",
        "y": "5",
        "blur": "4",
        "spread": "0",
        "color": "rgba(0,0,0,0.1)",
        "type": "dropShadow"
      },
      "$type": "boxShadow"
    },
    "shd-nav": {
      "$value": {
        "x": "1",
        "y": "-10",
        "blur": "30",
        "spread": "0",
        "color": "rgba(0,0,0,0.07)",
        "type": "dropShadow"
      },
      "$type": "boxShadow"
    },
    "shd-overlay": {
      "$value": {
        "x": "0",
        "y": "2",
        "blur": "8",
        "spread": "0",
        "color": "rgba(0,0,0,0.1)",
        "type": "dropShadow"
      },
      "$type": "boxShadow"
    },
    "family-text": {
      "$value": "Ubuntu",
      "$type": "fontFamilies"
    },
    "ft-siz-3x-small": {
      "$value": "0.625rem",
      "$type": "fontSizes"
    },
    "ft-siz-2x-small": {
      "$value": "0.7rem",
      "$type": "fontSizes"
    },
    "ft-siz-x-small": {
      "$value": "0.8rem",
      "$type": "fontSizes"
    },
    "ft-siz-small": {
      "$value": "1rem",
      "$type": "fontSizes"
    },
    "ft-siz-medium": {
      "$value": "1.125rem",
      "$type": "fontSizes"
    },
    "ft-siz-large": {
      "$value": "1.25rem",
      "$type": "fontSizes"
    },
    "ft-siz-x-large": {
      "$value": "1.5rem",
      "$type": "fontSizes"
    },
    "ft-siz-2x-large-mob": {
      "$value": "1.625rem",
      "$type": "fontSizes"
    },
    "ft-siz-3x-large-mob": {
      "$value": "1.875rem",
      "$type": "fontSizes"
    },
    "ft-siz-x-large-mob": {
      "$value": "1.375rem",
      "$type": "fontSizes"
    },
    "ft-siz-2x-large": {
      "$value": "2rem",
      "$type": "fontSizes"
    },
    "ft-siz-3x-large": {
      "$value": "3rem",
      "$type": "fontSizes"
    },
    "H1": {
      "$value": {
        "fontFamily": "{family-text}",
        "fontWeight": "600",
        "fontSize": "{ft-siz-3x-large}",
        "lineHeight": "1.1"
      },
      "$type": "typography"
    },
    "H2": {
      "$value": {
        "fontFamily": "{family-text}",
        "fontWeight": "600",
        "fontSize": "{ft-siz-2x-large}",
        "lineHeight": "1.1"
      },
      "$type": "typography"
    },
    "H3": {
      "$value": {
        "fontFamily": "{family-text}",
        "fontWeight": "600",
        "fontSize": "{ft-siz-x-large}",
        "lineHeight": "1.1"
      },
      "$type": "typography"
    },
